JEVMODEL_API_KEY=
JEV_ENDPOINT=https://jevmodel.org/v1/systemone
JEV_MODEL_ID=jev-latest
MODEL=jev

MT5_BRIDGE_URL=http://127.0.0.1:8765
MT5_SYMBOL=XAUUSD
MT5_TIMEFRAME=M5
MT5_REQUEST_TIMEOUT_MS=5000

DRY_RUN=true
LOT_SIZE=0.01
MAX_POSITIONS=1
MAX_LOTS=0.10
MAX_SPREAD_POINTS=30
MIN_PROBABILITY=0.60
MIN_PROBABILITY_EDGE=0.15
HORIZON_MINUTES=15
STOP_LOSS_ATR=1.5
TAKE_PROFIT_ATR=2.0
MAX_DAILY_LOSS=100
CANDLES=500
